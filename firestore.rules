rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.email.lower() == "admin@shiftmate-login.com"
          || request.auth.token.email.lower() == "d7445@shiftmate-login.com"
        );
    }

    match /shiftUsers/{employeeId} {
      allow read: if isAdmin() || (
        request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.split("@")[0].lower() == employeeId.lower()
      );

      allow create, delete: if isAdmin();

      allow update: if isAdmin() || (
        request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.split("@")[0].lower() == employeeId.lower() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uid", "updatedAt"]) &&
        request.resource.data.uid == request.auth.uid
      );
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    match /aiShiftGroups/{groupId} {
      allow read: if isAdmin() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAdmin() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isAdmin() && resource.data.ownerUid == request.auth.uid;
    }

    match /globalEvents/{eventId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /holidayOverrides/{holidayId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /trips/{tripId} {
      allow read, write: if request.auth != null;
    }

    match /invites/{inviteId} {
      allow read, write: if request.auth != null;
    }

    match /shares/{shareId} {
      allow read, write: if request.auth != null;
    }

    // 每月份的休假 Excel 解析資料：
    // 所有登入員工可讀，只有管理者可上傳／移除。
    match /attendanceMonths/{monthKey} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // 每月份出勤表照片直接以壓縮 data URL 儲存在 Firestore，
    // 不使用 Firebase Storage。
    match /monthPhotos/{monthKey}/items/{photoId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
  }
}
